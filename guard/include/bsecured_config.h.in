// Generated by CMake from the build configuration. The bSecured CLI fills these
// in per build; the defaults in CMakeLists.txt only ease a standalone build.
//
// This is where the per-build secrets live in the compiled binary: the device's
// signing seed, and the public-key pin of the server it trusts. By design, the
// binary carries the seed and the device id, never the dashboard key.
#pragma once

#define BSEC_SERVER_HOST   "@BSEC_SERVER_HOST@"   // host for the TLS pin check
#define BSEC_SERVER_PORT   "@BSEC_SERVER_PORT@"   // port for the TLS pin check
#define BSEC_REPORT_URL    "@BSEC_REPORT_URL@"    // server base URL for POSTing reports
#define BSEC_PINNED_SPKI   "@BSEC_PINNED_SPKI@"   // base64 SHA-256 of the server's expected SPKI
#define BSEC_DEVICE_ID     "@BSEC_DEVICE_ID@"     // this build's device id
#define BSEC_BUILD_ID      "@BSEC_BUILD_ID@"      // this build's id
#define BSEC_SEED_B64      "@BSEC_SEED_B64@"      // base64 32-byte Ed25519 signing seed
#define BSEC_CA_FILE       "@BSEC_CA_FILE@"       // CA bundle for verification; "" = system trust store
#define BSEC_POLL_SECONDS  @BSEC_POLL_SECONDS@    // seconds between checks
