# bSecured server configuration. All values are read from the environment.
#
# The DATABASE_URL below is a SECRET once set to a real database — keep the real
# .env out of git. With no DATABASE_URL, the server uses the in-memory prototype
# store (data lost on restart) and needs no secrets.

# --- Store -----------------------------------------------------------------
# PostgreSQL (e.g. Neon) connection strings. `neon` writes both into the
# repo-root .env.local (gitignored); the `dev` and `db:init` scripts read it via
# --env-file=../.env.local. On Render, set DATABASE_URL in the dashboard instead.
#   DATABASE_URL           pooled (-pooler host)  -> used by the running server
#   DATABASE_URL_UNPOOLED  direct (no -pooler)    -> used by `npm run db:init`
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Database TLS: unset verifies the certificate (correct for Neon). Set to
# `disable` only for a local, non-TLS Postgres. There is no "skip verification"
# option by design; trust a private CA with NODE_EXTRA_CA_CERTS instead.
# DATABASE_SSL=
#
# Force a store regardless of DATABASE_URL: memory | postgres
# BSEC_STORE=

# --- Network ---------------------------------------------------------------
# On a host like Render, PORT is injected and the server binds 0.0.0.0 for you.
# Locally it defaults to 127.0.0.1:8000.
# BSEC_HOST=127.0.0.1
# BSEC_PORT=8000
# BSEC_MAX_BODY_BYTES=8192

# --- Local HTTPS (optional) ------------------------------------------------
# For local HTTPS (needed to test the guard's TLS pin / certificate rotation),
# set both to a certificate and its key. On Render, TLS is terminated at the
# edge, so leave these unset there.
# BSEC_TLS_CERT=dev-cert.pem
# BSEC_TLS_KEY=dev-key.pem
